# =============================================================================
# AskLytix Frontend Environment Variables Template
# =============================================================================
# Copy this file to .env:
# cp .env.example .env

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend API Base URL (leave empty if using Vite proxy during local development)
VITE_API_URL=
